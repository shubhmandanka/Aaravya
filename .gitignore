# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# generated
/src/generated

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - contain real secrets in a real deployment; the committed
# defaults here are dev-only Docker Compose values, but this should not be
# relied on. Keep .env.example (checked in) as the template instead.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

aaravya_backup.dump
