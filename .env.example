# Copy this file to .env and fill in real values. Both `docker compose up`
# and running the app directly on the host (`npm run dev`, `npx prisma
# studio`, migration/introspection commands) read this file — Compose now
# loads it via the app service's `env_file:` in docker-compose.yml, and the
# host-side tools read it directly (or via `dotenv/config`, e.g. in
# prisma.config.ts and prisma/seed.ts).
#
# The database is Supabase Postgres, not a local Docker Postgres — the `db`
# service in docker-compose.yml is kept only as a Postgres-client toolbox
# (pg_dump/pg_restore/psql), not as the app's actual datastore.
#
# DATABASE_URL: Supabase's transaction-mode pooler (port 6543,
# `?pgbouncer=true`) — used for the app's normal query traffic.
# DIRECT_URL: Supabase's session-mode pooler (port 5432) — required for
# `prisma migrate`/`db pull` and other tools that need the full Postgres
# wire protocol, which PgBouncer's transaction mode doesn't support.
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase project settings (Project Settings → API in the Supabase
# dashboard). NEXT_PUBLIC_SUPABASE_ANON_KEY is safe to expose to the
# browser by design; SUPABASE_SERVICE_ROLE_KEY is NOT — server-side only,
# never commit it, never send it to the client. It's used only by
# scripts/create-admin-user.ts to provision admin logins via the Supabase
# Auth Admin API.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"

SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="Aaravya Hospital <no-reply@aaravyahospital.local>"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
